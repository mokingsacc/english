{
  "name": "firstpass",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/{engine,worker,page}/**/*.test.{mjs,js}\"",
    "test:web": "node --test --test-concurrency=1 \"tests/web/**/*.test.mjs\"",
    "dev": "node --disable-warning=ExperimentalWarning scripts/dev-server.mjs",
